[Unit]
Description=horar: site + readings API (0.0.0.0:8080)
Requires=horar-pg.service
After=horar-pg.service

[Service]
WorkingDirectory=%h/horar/server
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do (echo > /dev/tcp/127.0.0.1/54329) 2>/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/node --env-file=.env dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target

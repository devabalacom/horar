{
  "name": "horar-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for horar: readings from the books (RAG + Claude) and Похоже/Мимо feedback",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts src/ingest.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --alias:@=../src",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "ingest": "tsx --env-file-if-exists=.env src/ingest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "astronomy-engine": "^2.1.19",
    "hono": "^4.13.17",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

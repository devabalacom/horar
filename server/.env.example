# Postgres. One database for the books, the readings and the feedback.
DATABASE_URL=postgres://horar:horar@127.0.0.1:5432/horar

# Claude. The key comes from console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Model and reasoning effort for the readings (low | medium | high | xhigh | max).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

PORT=8787
# Origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,https://devabalacom.github.io
# Readings per IP per hour. Each one costs money; cached charts don't count.
READINGS_PER_HOUR=6
# Salt for hashing IPs before they are stored next to feedback.
IP_SALT=change-me
# Set when the API sits behind nginx, so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false
